global
    maxconn 1000
    log /dev/log local0

defaults
    mode tcp
    log global
    retries 2
    timeout connect 4s
    timeout client 30m
    timeout server 30m
    timeout check 5s

listen stats
    mode http
    bind *:7000
    stats enable
    stats uri /

listen primary
    bind *:5000
    option httpchk GET /primary
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
    server pg1 192.168.105.51:5432 maxconn 100 check port 8008
    server pg2 192.168.105.52:5432 maxconn 100 check port 8008
    server pg3 192.168.105.53:5432 maxconn 100 check port 8008

listen replicas
    bind *:5001
    balance roundrobin
    option httpchk GET /replica
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
    server pg1 192.168.105.51:5432 maxconn 100 check port 8008
    server pg2 192.168.105.52:5432 maxconn 100 check port 8008
    server pg3 192.168.105.53:5432 maxconn 100 check port 8008
